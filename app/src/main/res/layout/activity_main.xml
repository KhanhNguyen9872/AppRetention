<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="AppRetention"
            app:titleTextColor="@color/text_title"
            app:subtitle="Xposed API 101 • Android 16"
            app:subtitleTextColor="@color/text_body" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. System Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="System Status"
                                android:textColor="@color/text_title"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● Active (API 101)"
                                android:textColor="@color/accent_green"
                                android:background="@drawable/bg_badge_green"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMemoryInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Detecting system RAM..."
                            android:textColor="@color/text_body"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvShieldCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Shielded Kills: 0"
                            android:textColor="@color/primary_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. VIP Apps Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="VIP App Whitelist"
                            android:textColor="@color/text_title"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Apps selected here are permanently pinned at ADJ 200 (Total Kill Immunity), regardless of how many other apps are opened."
                            android:textColor="@color/text_body"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvVipSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pinned: 0 apps"
                            android:textColor="@color/primary_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnManageVip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Select VIP Apps"
                            app:cornerRadius="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Feature Switches Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Retention Controls"
                            android:textColor="@color/text_title"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <!-- Switch 1: Tiered ADJ -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchTieredAdj"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tiered ADJ Clamping (ADJ 200)"
                            android:textColor="@color/text_title"
                            android:checked="true" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Places top recent apps at ADJ 200-249 (same priority as active music playback)."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Switch 2: Kill Shield -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchKillShield"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="AOSP Kill Shield"
                            android:textColor="@color/text_title"
                            android:checked="true" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Blocks automated broadcast timeouts, cached idle sweeps, and excessive CPU kills."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Switch 3: Doze Whitelist -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchDoze"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Auto Doze &amp; Battery Exemption"
                            android:textColor="@color/text_title"
                            android:checked="true" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Maintains background network and wakelocks when the screen is locked."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Switch 4: Nubia / RedMagic -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchNubia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RedMagic / Nubia Policy Suppression"
                            android:textColor="@color/text_title"
                            android:checked="true" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Suppresses NeoPower, SmartEngine, and GameSpace background purgers."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Switch 5: Hibernation -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchHibernation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Disable App Hibernation"
                            android:textColor="@color/text_title"
                            android:checked="true" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Prevents Android from freezing unused apps or revoking their permissions."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp" />

                        <!-- Switch 6: AutoStart -->
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAutoStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bypass OEM Auto-Start Restrictions"
                            android:textColor="@color/text_title"
                            android:checked="true" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ensures all user apps receive BOOT_COMPLETED intents on phone restart."
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Live Process & OOM ADJ Monitor -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Active Background Processes"
                                android:textColor="@color/text_title"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProcessCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 processes"
                                android:textColor="@color/text_body"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvProcesses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Real-Time Log Viewer -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/card_dark"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Retention Log"
                                android:textColor="@color/text_title"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClearLog"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clear"
                                android:textColor="@color/text_body" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvLogContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="15"
                            android:ellipsize="end"
                            android:background="@color/card_inner"
                            android:padding="12dp"
                            android:fontFamily="monospace"
                            android:text="Log will appear here as retention events occur..."
                            android:textColor="@color/text_body"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
