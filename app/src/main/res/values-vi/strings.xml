    <!-- Root Permission Explanation Dialog -->
    <string name="dialog_root_title">Quyền Root Chưa Được Cấp</string>
    <string name="dialog_root_message">AppRetention vẫn đang hoạt động ổn định ở tầng System Framework (các cơ chế khóa giữ nền và chống kill ngầm của module Xposed vẫn có hiệu lực).\n\nTuy nhiên, quyền Root là cần thiết để:\n• Đọc chính xác 100% tài nguyên phần cứng (CPU kernel load, RAM meminfo, Storage df).\n• Quét danh sách tiến trình chạy ngầm &amp; OOM Score ADJ theo thời gian thực.\n• Đồng bộ các thuộc tính hệ thống (persist properties) ngay lập tức.\n\nBạn có thể cấp quyền trong Magisk, KernelSU hoặc APatch bất cứ lúc nào.</string>
    <string name="btn_dialog_retry_root">Thử lại / Cấp quyền</string>
    <string name="btn_dialog_continue_limited">Tiếp tục (Chế độ hạn chế)</string>

