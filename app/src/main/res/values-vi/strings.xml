    <!-- Retention Controls Card -->
    <string name="title_retention_controls">Cấu Hình Giữ Đa Nhiệm</string>
    <string name="title_tiered_adj">Phân Tầng Kẹp Giữ Nền</string>
    <string name="desc_tiered_adj">Đẩy các app ngầm gần nhất lên phân tầng Perceptible (ADJ 200-245) để giữ trạng thái sống liên tục.</string>
    <string name="title_killshield">Khiên Bảo Vệ KillShield</string>
    <string name="desc_killshield">Chặn hệ thống tự động diệt app do quá giờ, tăng tải CPU hoặc dọn dẹp bộ nhớ đệm, nhưng vẫn cho phép vuốt tắt thủ công.</string>
    <string name="title_doze">Miễn Trừ Chế Độ Doze Tự Động</string>
    <string name="desc_doze">Duy trì kết nối mạng, báo thức và socket cho tất cả các app chạy nền ngay cả khi tắt màn hình.</string>
    <string name="title_nubia">Khiên Chống Diệt App RedMagic / Nubia</string>
    <string name="desc_nubia">Vô hiệu hóa trình dọn dẹp bộ nhớ NeoPower, SmartEngine và GameSpace trên thiết bị RedMagic.</string>
    <string name="title_hibernation">Tắt Đóng Băng Ứng Dụng (App Hibernation)</string>
    <string name="desc_hibernation">Ngăn Android tự động đóng băng các app ít dùng hoặc tự ý thu hồi quyền hạn.</string>
    <string name="title_autostart">Bỏ Qua Giới Hạn Tự Khởi Chạy Của OEM</string>
    <string name="desc_autostart">Đảm bảo tất cả app người dùng nhận được tín hiệu BOOT_COMPLETED khi khởi động lại máy.</string>

