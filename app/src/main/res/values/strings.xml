    <!-- Root Permission Explanation Dialog -->
    <string name="dialog_root_title">Root Permission Not Granted</string>
    <string name="dialog_root_message">AppRetention is still actively functioning as an Xposed Module in System Framework (Keep-Alive locking and kill prevention remain fully effective).\n\nHowever, Root access is required to:\n• Accurately read 100% hardware metrics (kernel CPU load, RAM meminfo, storage df).\n• Scan running background processes &amp; OOM Score ADJ in real time.\n• Synchronize system persist properties immediately.\n\nYou can grant Root permission in Magisk, KernelSU, or APatch anytime.</string>
    <string name="btn_dialog_retry_root">Retry / Grant</string>
    <string name="btn_dialog_continue_limited">Continue (Limited Mode)</string>

