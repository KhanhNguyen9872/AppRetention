    <!-- Retention Controls Card -->
    <string name="title_retention_controls">Retention Controls</string>
    <string name="title_tiered_adj">Tiered ADJ 200 Clamping</string>
    <string name="desc_tiered_adj">Bumps top background apps to Perceptible tier (ADJ 200-245) for persistent background retention.</string>
    <string name="title_killshield">KillShield Protection</string>
    <string name="desc_killshield">Blocks automated system kills from timeout, cpu spikes, and idle sweeps while allowing manual swipe.</string>
    <string name="title_doze">Doze Mode Auto-Exemption</string>
    <string name="desc_doze">Keeps network sockets, alarms, and sockets active for all background apps when screen is off.</string>
    <string name="title_nubia">RedMagic / Nubia Killer Shield</string>
    <string name="desc_nubia">Suppresses NeoPower, SmartEngine, and GameSpace background memory purgers on RedMagic devices.</string>
    <string name="title_hibernation">Disable App Hibernation</string>
    <string name="desc_hibernation">Prevents Android from freezing unused apps or revoking their permissions.</string>
    <string name="title_autostart">Bypass OEM Auto-Start Restrictions</string>
    <string name="desc_autostart">Ensures all user apps receive BOOT_COMPLETED intents on phone restart.</string>

